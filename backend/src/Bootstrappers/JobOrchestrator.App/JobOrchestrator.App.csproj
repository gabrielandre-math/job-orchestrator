<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <AssemblyName>job-orchestrator</AssemblyName>
    <RootNamespace>JobOrchestrator.App</RootNamespace>
    <Version>1.0.3</Version>
  </PropertyGroup>
  <!-- No Windows, app de janela (dois cliques não abrem console) e com o ícone; pelo terminal, a saída vai para o console de quem chamou. -->
