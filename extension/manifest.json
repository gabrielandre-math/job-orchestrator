{
  "manifest_version": 3,
  "name": "Job Orchestrator: copiloto",
  "version": "1.1.0",
  "description": "Preenche o formulário de candidatura com os seus dados aprovados no Job Orchestrator. Você confere e envia; a extensão nunca clica em enviar.",
  "permissions": ["activeTab", "scripting"],
  "host_permissions": ["http://127.0.0.1:7410/*"],
  "background": { "service_worker": "background.js" },
  "action": { "default_popup": "popup.html", "default_title": "Job Orchestrator: preencher esta candidatura", "default_icon": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png" } },
  "icons": { "16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" }
}
